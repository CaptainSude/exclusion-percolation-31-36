/-!
Audit every declaration in the project's mathematical namespaces, including
definitions and generated declarations. This checks their transitive axiom
dependencies. It does not discharge explicit theorem hypotheses, and it does
not certify the external correspondence between those hypotheses and their cited sources.
-/

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let mut declarations : Nat := 0
  let mut theorems : Nat := 0
  for (name, info) in env.constants.toList do
    let label := name.toString
    if label.startsWith "ExceptionalTimes." || label.startsWith "ExceptionalTimesPilot." ||
        label.startsWith "DimerBinaryResponse." || label.startsWith "AdaptiveExchange." then
      declarations := declarations + 1
      if info.isTheorem then theorems := theorems + 1
      for axiomName in (← Lean.collectAxioms name) do
        unless axiomName == ``propext || axiomName == ``Classical.choice ||
            axiomName == ``Quot.sound do
          throwError "Unexpected axiom {axiomName} in project declaration {name}"
  logInfo m!"Axiom audit passed: {declarations} project declarations, including {theorems} theorems."
  logInfo "Only propext, Classical.choice and Quot.sound are permitted. The full conditional 31/36 theorem is included; explicit literature hypotheses remain."











